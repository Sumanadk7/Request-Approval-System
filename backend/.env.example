# Copy to .env and fill in local values. Never commit .env.
DB_NAME=requestapproval_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Generate a fresh one per environment, e.g.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# Login rate limit (requests per period, e.g. 20/hour, 5/minute).
# Takes effect on process start (restart the server after changing).
LOGIN_THROTTLE_RATE=20/hour
